# 变量必须以 VITE_ 为前缀才能暴露给外部读取
# NODE_ENV 只有  development  和 production 两个可用值，其他值都不允许
NODE_ENV = 'development'
VITE_APP_TITLE = '运营平台'
VITE_APP_BASE_API = '/suyh'
VITE_ROUTE_PREFIX = ''
VITE_APP_FILE_UPLOAD_API = '/system/file/oss/upload'
VITE_SERVE="http://localhost:8137"
# VITE_SERVE="http://qu-yun.isuyh.com:8015"
